{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/random/index",
      "style": {
        "navigationBarTitleText": "来做吧 LetsDo",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    },
    {
      "path": "pages/recipe/library",
      "style": {
        "navigationBarTitleText": "菜品库",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor",
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/recipe/detail",
      "style": {
        "navigationBarTitleText": "菜品详情",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    },
    {
      "path": "pages/ingredient/detail",
      "style": {
        "navigationBarTitleText": "食材详情",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    },
    {
      "path": "pages/exercise/library",
      "style": {
        "navigationBarTitleText": "运动库",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor",
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/exercise/detail",
      "style": {
        "navigationBarTitleText": "运动详情",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    },
    {
      "path": "pages/avatar/index",
      "style": {
        "navigationBarTitleText": "我的形象",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    },
    {
      "path": "pages/rank/index",
      "style": {
        "navigationBarTitleText": "积分排行榜",
        "navigationBarBackgroundColor": "@navBgColor",
        "navigationBarTextStyle": "@navTxtStyle",
        "backgroundColor": "@bgColor"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "来做吧 LetsDo",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor"
  }
}
